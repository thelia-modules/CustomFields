{# Included by custom-field-list.html.twig — general custom field values (Twig BO). #}
<div class="form-container">
    <form method="POST"
          action="/admin/module/customfields/values/save"
          enctype="multipart/form-data"
          class="clearfix">

        <input type="hidden" name="{{ value_form.source_id.vars.full_name }}" value="1" />
        <input type="hidden" name="{{ value_form.source.vars.full_name }}" value="general" />
        <input type="hidden" name="{{ value_form.vars.full_name }}[_token]" value="{{ value_form._token.vars.value }}" />
        <input type="hidden" name="edit_language_id" value="{{ edit_language_id }}" />

        {% include 'includes/inner-form-toolbar.html.twig' with {
            hide_flags: false,
            hide_submit_buttons: false,
            langs: langs,
            edit_language_id: edit_language_id,
            page_url: '/admin/module/customfields/list'
        } %}

        {% if general_custom_fields|length > 0 %}
            {% include '@CustomFieldsModule/backOffice/default-twig/includes/fields-list.html.twig' with {
                source: 'general',
                grouped_fields: grouped_general_fields,
                values: general_values,
                value_ids: general_value_ids,
                repeater_values: general_repeater_values,
                repeater_subfields: general_repeater_subfields
            } %}
        {% else %}
            <div class="alert alert-info">
                {{ "No general custom fields defined. Create custom fields with 'general' source first."|trans({}, 'customfields') }}
            </div>
        {% endif %}
    </form>
    {{ safe_hook('wysiwyg.js', {location: 'wysiwyg-customfields-general-js'}) }}

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form[action*="customfields/values/save"]');
        if (form) {
            form.addEventListener('submit', function(e) {
                const fileInputs = form.querySelectorAll('input[type="file"]');
                fileInputs.forEach(function(input) {
                    if (!input.files || input.files.length === 0 || input.files[0].size === 0) {
                        input.removeAttribute('name');
                    }
                });
            });
        }

        document.querySelectorAll('.delete-custom-field-image').forEach(function(link) {
            link.addEventListener('click', function(e) {
                const confirmMessage = this.getAttribute('data-confirm');
                if (!confirm(confirmMessage)) {
                    e.preventDefault();
                }
            });
        });
    });
    </script>
</div>
