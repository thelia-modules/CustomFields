{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Option Pages'|trans({}, 'customfields') }}{% endblock %}

{% block content %}
    {% if app.request.query.get('success') is not empty %}
        <div class="alert alert-success">{{ app.request.query.get('success') }}</div>
    {% endif %}
    {% if app.request.query.get('error') is not empty %}
        <div class="alert alert-danger">{{ app.request.query.get('error') }}</div>
    {% endif %}

    <div class="general-block-decorator">
        <div class="row">
            <div class="col-md-8">
                <h3>{{ 'Option Pages'|trans({}, 'customfields') }}</h3>

                {% if option_pages|length > 0 %}
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>{{ 'ID'|trans }}</th>
                                <th>{{ 'Title'|trans }}</th>
                                <th>{{ 'Code'|trans }}</th>
                                <th>{{ 'Actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for page in option_pages %}
                                <tr>
                                    <td>{{ page.id }}</td>
                                    <td><a href="/admin/module/customfields/option-pages/view/{{ page.id }}">{{ page.title }}</a></td>
                                    <td><code>{{ page.code }}</code></td>
                                    <td>
                                        <a href="/admin/module/customfields/option-pages/view/{{ page.id }}" class="btn btn-sm btn-primary" title="{{ 'View'|trans }}">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form method="post" class="d-inline" action="/admin/module/customfields/option-pages/delete/{{ page.id }}?_token={{ assignToken() }}"
                                              onsubmit="return confirm('{{ 'Are you sure you want to delete this option page?'|trans({}, 'customfields') }}');">
                                            <button type="submit" class="btn btn-sm btn-danger" title="{{ 'Delete'|trans }}">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="alert alert-info">{{ 'No option pages created yet.'|trans({}, 'customfields') }}</div>
                {% endif %}
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">{{ 'Create an Option Page'|trans({}, 'customfields') }}</h3>
                    </div>
                    <div class="card-body">
                        <form action="/admin/module/customfields/option-pages/create" method="POST">
                            <input type="hidden" name="{{ option_page_form.vars.full_name }}[_token]" value="{{ option_page_form._token.vars.value }}" />

                            <div class="mb-3">
                                <label for="{{ option_page_form.title.vars.id }}" class="form-label">{{ option_page_form.title.vars.label }}</label>
                                <input type="text" class="form-control" id="{{ option_page_form.title.vars.id }}"
                                       name="{{ option_page_form.title.vars.full_name }}" required
                                       placeholder="{{ 'Page title'|trans({}, 'customfields') }}" value="{{ option_page_form.title.vars.value }}">
                            </div>

                            <div class="mb-3">
                                <label for="{{ option_page_form.code.vars.id }}" class="form-label">{{ option_page_form.code.vars.label }}</label>
                                <input type="text" class="form-control" id="{{ option_page_form.code.vars.id }}"
                                       name="{{ option_page_form.code.vars.full_name }}" required pattern="[a-z0-9_]+"
                                       placeholder="{{ 'unique_code'|trans({}, 'customfields') }}" value="{{ option_page_form.code.vars.value }}">
                                <p class="form-text">{{ 'Lowercase letters, numbers and underscores only'|trans({}, 'customfields') }}</p>
                            </div>

                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-lg"></i> {{ 'Create'|trans({}, 'customfields') }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
