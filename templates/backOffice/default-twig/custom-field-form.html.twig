{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Custom Fields'|trans({}, 'customfields') }}{% endblock %}

{% block content %}
    {% if app.request.query.get('error') is not empty %}
        <div class="alert alert-danger">{{ app.request.query.get('error') }}</div>
    {% endif %}

    <div class="general-block-decorator">
        <form method="POST" enctype="multipart/form-data" class="clearfix customfield-form">
            <input type="hidden" name="{{ form.vars.full_name }}[_token]" value="{{ form._token.vars.value }}" />
            <input type="hidden" name="{{ form.id.vars.full_name }}" value="{{ form.id.vars.value }}" />

            {% if error is defined and error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}

            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">
                                {{ custom_field ? 'Edit custom field'|trans({}, 'customfields') : 'Create a custom field'|trans({}, 'customfields') }}
                            </h4>
                        </div>

                        <div class="card-body">
                            {% if parent_repeater %}
                                <div class="alert alert-info mb-4">
                                    <i class="bi bi-arrow-up"></i>
                                    {{ 'Repeater sub-field'|trans({}, 'customfields') }} :
                                    <strong>{{ parent_repeater.title }}</strong>
                                    &nbsp;&mdash;&nbsp;
                                    <a href="/admin/module/customfields/update/{{ parent_repeater.id }}">
                                        {{ 'Back to repeater'|trans({}, 'customfields') }}
                                    </a>
                                </div>
                            {% endif %}

                            {# Title #}
                            <div class="mb-3">
                                <label for="{{ form.title.vars.label_attr.for }}" class="form-label">
                                    {{ form.title.vars.label }}{% if form.title.vars.required %} <span class="required">*</span>{% endif %}
                                </label>
                                <input type="text" id="{{ form.title.vars.label_attr.for }}" name="{{ form.title.vars.full_name }}"
                                       class="form-control{{ form.title.vars.errors|length ? ' is-invalid' : '' }}" value="{{ form.title.vars.value }}"
                                       {{ form.title.vars.required ? 'required' : '' }}
                                       placeholder="{{ 'Enter the title'|trans({}, 'customfields') }}" />
                                {% if form.title.vars.errors|length %}<span class="form-text text-danger">{{ form_errors(form.title) }}</span>{% endif %}
                            </div>

                            {# Code #}
                            <div class="mb-3">
                                <label for="{{ form.code.vars.label_attr.for }}" class="form-label">
                                    {{ form.code.vars.label }}{% if form.code.vars.required %} <span class="required">*</span>{% endif %}
                                </label>
                                <input type="text" id="{{ form.code.vars.label_attr.for }}" name="{{ form.code.vars.full_name }}"
                                       class="form-control{{ form.code.vars.errors|length ? ' is-invalid' : '' }}" value="{{ form.code.vars.value }}"
                                       {{ form.code.vars.required ? 'required' : '' }}
                                       placeholder="{{ 'Enter the code (e.g., my_custom_field)'|trans({}, 'customfields') }}" />
                                {% if form.code.vars.errors|length %}<span class="form-text text-danger">{{ form_errors(form.code) }}</span>{% endif %}
                                <span class="form-text">{{ 'Use only lowercase letters, numbers and underscores'|trans({}, 'customfields') }}</span>
                            </div>

                            {# Type #}
                            <div class="mb-3">
                                <label for="{{ form.type.vars.label_attr.for }}" class="form-label">
                                    {{ form.type.vars.label }}{% if form.type.vars.required %} <span class="required">*</span>{% endif %}
                                </label>
                                <select id="{{ form.type.vars.label_attr.for }}" name="{{ form.type.vars.full_name }}" class="form-control" {{ form.type.vars.required ? 'required' : '' }}>
                                    <option value="">{{ 'Select a type'|trans({}, 'customfields') }}</option>
                                    {% for choice in form.type.vars.choices %}
                                        <option value="{{ choice.value }}" {{ form.type.vars.value == choice.value ? 'selected' : '' }}>{{ choice.label }}</option>
                                    {% endfor %}
                                </select>
                                {% if form.type.vars.errors|length %}<span class="form-text text-danger">{{ form_errors(form.type) }}</span>{% endif %}
                            </div>

                            {# International #}
                            <div class="mb-3">
                                <label for="{{ form.is_international.vars.label_attr.for }}" class="form-label d-flex align-items-center gap-2">
                                    {{ form.is_international.vars.label }}
                                    <input type="checkbox" class="form-check-input m-0" id="{{ form.is_international.vars.label_attr.for }}"
                                           name="{{ form.is_international.vars.full_name }}" value="1"
                                           {{ form.is_international.vars.checked ? 'checked' : '' }} />
                                </label>
                                <span class="form-text">{{ 'Check to allow translation of the field'|trans({}, 'customfields') }}</span>
                            </div>

                            {# Sources — hidden for sub-fields #}
                            <div class="mb-3" {{ parent_repeater ? 'style="display:none;"' : '' }}>
                                <label for="{{ form.sources.vars.label_attr.for }}" class="form-label">
                                    {{ form.sources.vars.label }}{% if form.sources.vars.required %} <span class="required">*</span>{% endif %}
                                </label>
                                <select id="{{ form.sources.vars.label_attr.for }}" name="{{ form.sources.vars.full_name }}[]" class="form-control" {{ form.sources.vars.required ? 'required' : '' }} multiple>
                                    {% for choice in form.sources.vars.choices %}
                                        <option value="{{ choice.value }}" {{ form.sources.vars.value is iterable and choice.value in form.sources.vars.value ? 'selected' : '' }}>{{ choice.label }}</option>
                                    {% endfor %}
                                </select>
                                {% if form.sources.vars.errors|length %}<span class="form-text text-danger">{{ form_errors(form.sources) }}</span>{% endif %}
                                <span class="form-text">{{ 'Hold Ctrl (Windows) or Cmd (Mac) to select multiple sources'|trans({}, 'customfields') }}</span>
                            </div>

                            {# Parent group — hidden for sub-fields #}
                            <div class="mb-3" {{ parent_repeater ? 'style="display:none;"' : '' }}>
                                <label for="{{ form.custom_field_parent_id.vars.label_attr.for }}" class="form-label">{{ form.custom_field_parent_id.vars.label }}</label>
                                <select id="{{ form.custom_field_parent_id.vars.label_attr.for }}" name="{{ form.custom_field_parent_id.vars.full_name }}" class="form-control">
                                    <option value="">{{ 'No parent'|trans({}, 'customfields') }}</option>
                                    {% for choice in form.custom_field_parent_id.vars.choices %}
                                        <option value="{{ choice.value }}" {{ form.custom_field_parent_id.vars.value == choice.value ? 'selected' : '' }}>{{ choice.label }}</option>
                                    {% endfor %}
                                </select>
                                <span class="form-text">{{ 'Select a parent group to organize this field'|trans({}, 'customfields') }}</span>
                            </div>

                            {# Create new parent — hidden for sub-fields #}
                            <div class="mb-3" {{ parent_repeater ? 'style="display:none;"' : '' }}>
                                <label for="{{ form.new_parent_title.vars.label_attr.for }}" class="form-label">{{ form.new_parent_title.vars.label }}</label>
                                <input type="text" id="{{ form.new_parent_title.vars.label_attr.for }}" name="{{ form.new_parent_title.vars.full_name }}"
                                       class="form-control" value="{{ form.new_parent_title.vars.value }}"
                                       placeholder="{{ 'Enter a new parent group name'|trans({}, 'customfields') }}" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Sub-fields section for repeater type #}
            {% if custom_field and custom_field.type == 'repeater' %}
                <div class="row mt-2">
                    <div class="col-md-12">
                        <div class="card border-info">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h4 class="card-title m-0">
                                    <i class="bi bi-list"></i>
                                    {{ 'Repeater sub-fields'|trans({}, 'customfields') }}
                                </h4>
                                <a href="/admin/module/customfields/create?parent_repeater_id={{ custom_field.id }}" class="btn btn-sm btn-success">
                                    <i class="bi bi-plus-lg"></i> {{ 'Add a sub-field'|trans({}, 'customfields') }}
                                </a>
                            </div>
                            <div class="card-body">
                                {% if sub_fields and sub_fields|length > 0 %}
                                    <table class="table table-striped table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>{{ 'Title'|trans({}, 'customfields') }}</th>
                                                <th>{{ 'Code'|trans({}, 'customfields') }}</th>
                                                <th>{{ 'Type'|trans({}, 'customfields') }}</th>
                                                <th class="text-end">{{ 'Actions'|trans({}, 'customfields') }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for sub_field in sub_fields %}
                                                <tr>
                                                    <td>{{ sub_field.title }}</td>
                                                    <td><code>{{ sub_field.code }}</code></td>
                                                    <td>{{ sub_field.type }}</td>
                                                    <td class="text-end">
                                                        <a href="/admin/module/customfields/update/{{ sub_field.id }}" class="btn btn-sm btn-secondary">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <a href="/admin/module/customfields/delete/{{ sub_field.id }}" class="btn btn-sm btn-danger"
                                                           onclick="return confirm('{{ 'Delete this sub-field?'|trans({}, 'customfields') }}');">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                {% else %}
                                    <div class="alert alert-warning mb-0">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        {{ 'No sub-field defined. Add one to start using this repeater.'|trans({}, 'customfields') }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="row">
                <div class="col-md-12">
                    <a href="/admin/module/customfields/list" class="btn btn-secondary">{{ 'Cancel'|trans({}, 'customfields') }}</a>
                    <button type="submit" class="btn btn-success float-end">
                        {{ custom_field ? 'Update'|trans({}, 'customfields') : 'Create'|trans({}, 'customfields') }}
                    </button>
                </div>
            </div>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const noInternational = ['content', 'category', 'folder', 'product', 'image', 'checkbox'];
            const isInternational = document.querySelector('#custom_field_is_international');
            const type = document.querySelector('#custom_field_type');

            if (isInternational && type) {
                type.addEventListener('input', function() {
                    if (noInternational.includes(type.value)) {
                        isInternational.checked = false;
                        isInternational.disabled = true;
                    } else {
                        isInternational.disabled = false;
                    }
                });
            }
        });
    </script>
{% endblock %}
