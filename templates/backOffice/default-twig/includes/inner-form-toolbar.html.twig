{# Language toolbar + submit buttons for the custom-field value forms (Twig BO). #}
{# Expected vars: langs (Lang collection), edit_language_id, page_url, page_bottom (bool), hide_flags, hide_submit_buttons #}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 my-3">
    {% if hide_flags is not defined or not hide_flags %}
        <div class="btn-group" role="group" aria-label="{{ 'Language'|trans({}, 'customfields') }}">
            {% for lang in langs %}
                {% set sep = page_url is defined and '?' in page_url ? '&' : '?' %}
                <a href="{{ page_url|default('') }}{{ sep }}edit_language_id={{ lang.id }}"
                   class="btn btn-sm {{ lang.id == edit_language_id ? 'btn-primary' : 'btn-secondary' }}">
                    {{ lang.code|upper }}
                </a>
            {% endfor %}
        </div>
    {% else %}
        <span></span>
    {% endif %}

    {% if hide_submit_buttons is not defined or not hide_submit_buttons %}
        <div class="btn-group" role="group">
            <button type="submit" name="save_mode" value="stay" class="btn btn-sm btn-success">
                <i class="bi bi-save"></i> {{ 'Save'|trans({}, 'customfields') }}
            </button>
        </div>
    {% endif %}
</div>
