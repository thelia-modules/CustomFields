{# Expected vars: grouped_fields, values, value_ids, repeater_values, repeater_subfields, source #}
<div>
    {# Fields without parent #}
    {% for custom_field in grouped_fields.no_parent %}
        {% include '@CustomFieldsModule/backOffice/default-twig/includes/fields.html.twig' with { custom_field: custom_field } %}
    {% endfor %}

    {# Parent field groups #}
    {% for parent_group in grouped_fields.parents %}
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="card-title m-0">
                    <i class="bi bi-folder2-open me-1"></i> {{ parent_group.parent.title }}
                </h5>
            </div>
            <div class="card-body">
                {% for custom_field in parent_group.children %}
                    {% include '@CustomFieldsModule/backOffice/default-twig/includes/fields.html.twig' with { custom_field: custom_field, source: source } %}
                {% endfor %}
            </div>
        </div>
    {% endfor %}
</div>
