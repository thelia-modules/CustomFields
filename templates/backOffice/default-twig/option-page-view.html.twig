{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ option_page.title }}{% endblock %}

{% block content %}
    {% if app.request.query.get('success') is not empty %}
        <div class="alert alert-success">{{ app.request.query.get('success') }}</div>
    {% endif %}
    {% if app.request.query.get('error') is not empty %}
        <div class="alert alert-danger">{{ app.request.query.get('error') }}</div>
    {% endif %}

    <div class="general-block-decorator">
        <div class="row">
            <div class="col-md-12">
                <div class="page-header">
                    <h2>
                        <i class="bi bi-file-earmark-text"></i>
                        {{ option_page.title }}
                        <small><code>{{ option_page.code }}</code></small>
                    </h2>
                </div>

                {% if custom_fields|length > 0 %}
                    <div class="form-container">
                        <form method="POST"
                              action="/admin/module/customfields/values/save"
                              enctype="multipart/form-data"
                              class="clearfix">

                            <input type="hidden" name="{{ value_form.source_id.vars.full_name }}" value="{{ option_page.id }}" />
                            <input type="hidden" name="{{ value_form.source.vars.full_name }}" value="{{ source }}" />
                            <input type="hidden" name="{{ value_form.vars.full_name }}[_token]" value="{{ value_form._token.vars.value }}" />
                            <input type="hidden" name="edit_language_id" value="{{ edit_language_id }}" />

                            {% include 'includes/inner-form-toolbar.html.twig' with {
                                hide_flags: false,
                                hide_submit_buttons: false,
                                langs: langs,
                                edit_language_id: edit_language_id,
                                page_url: '/admin/module/customfields/option-pages/view/' ~ option_page.id
                            } %}

                            {% include '@CustomFieldsModule/backOffice/default-twig/includes/fields-list.html.twig' with {
                                grouped_fields: grouped_fields,
                                values: values,
                                value_ids: value_ids,
                                repeater_values: repeater_values,
                                repeater_subfields: repeater_subfields,
                                source: source
                            } %}

                            {% include 'includes/inner-form-toolbar.html.twig' with {
                                hide_flags: false,
                                hide_submit_buttons: false,
                                langs: langs,
                                edit_language_id: edit_language_id,
                                page_url: '/admin/module/customfields/option-pages/view/' ~ option_page.id,
                                page_bottom: true
                            } %}
                        </form>
                        {{ safe_hook('wysiwyg.js', {location: 'wysiwyg-customfields-optionpage-js'}) }}

                        <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            const form = document.querySelector('form[action*="customfields/values/save"]');
                            if (form) {
                                form.addEventListener('submit', function(e) {
                                    const fileInputs = form.querySelectorAll('input[type="file"]');
                                    fileInputs.forEach(function(input) {
                                        if (!input.files || input.files.length === 0 || input.files[0].size === 0) {
                                            input.removeAttribute('name');
                                        }
                                    });
                                });
                            }
                            document.querySelectorAll('.delete-custom-field-image').forEach(function(link) {
                                link.addEventListener('click', function(e) {
                                    const confirmMessage = this.getAttribute('data-confirm');
                                    if (!confirm(confirmMessage)) {
                                        e.preventDefault();
                                    }
                                });
                            });
                        });
                        </script>
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        {{ 'No custom fields assigned to this option page. Create custom fields with the source \'%source\' first.'|trans({'%source': source}, 'customfields') }}
                    </div>
                {% endif %}

                <a href="/admin/module/customfields/list?current_tab=option_pages" class="btn btn-secondary mt-3">
                    <i class="bi bi-arrow-left"></i> {{ 'Back to Custom Fields'|trans({}, 'customfields') }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
